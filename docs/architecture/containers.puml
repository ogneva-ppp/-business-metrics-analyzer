@startuml
!include https://raw.githubusercontent.com/plantuml-stdlib/C4-PlantUML/master/C4_Container.puml
Person(director, "Коммерческий директор", "Просматривает KPI и отчёты")
Person(manager, "Менеджер по продажам", "Работает с данными продаж")
Person(analyst, "Аналитик", "Формирует и экспортирует отчёты")
Person(admin, "Администратор", "Управляет пользователями и метриками")
System_Boundary(bma, "Business Metrics Analyzer") {
  Container(web, "Web UI", "HTML/JS", "Интерфейс пользователя")
  Container(api, "REST API", "Python, FastAPI", "Основной API приложения")
  Container(auth, "Сервис аутентификации", "Python, JWT", "Аутентификация и авторизация")
  Container(importer, "Сервис импорта", "Python, pandas", "Импорт данных о продажах")
  Container(kpi, "Сервис KPI", "Python", "Расчёт метрик")
  Container(reports, "Сервис отчётов", "Python, openpyxl", "Формирование и экспорт отчётов")
  ContainerDb(db, "База данных", "PostgreSQL", "Хранение данных о продажах и KPI")
  ContainerDb(cache, "Кэш", "Redis", "Кэширование KPI")
  ContainerDb(storage, "Файловое хранилище", "S3/MinIO", "Сгенерированные отчёты")
}
System_Ext(source, "Источник данных", "1С / CSV / Excel", "Поставка данных о продажах")
System_Ext(email, "Сервис уведомлений", "SMTP", "Отправка уведомлений")
Rel(director, web, "Использует", "HTTPS")
Rel(manager, web, "Использует", "HTTPS")
Rel(analyst, web, "Использует", "HTTPS")
Rel(admin, web, "Использует", "HTTPS")
Rel(web, api, "Запросы", "REST/JSON")
Rel(api, auth, "Проверка токена")
Rel(api, importer, "Импорт")
Rel(api, kpi, "Расчёт KPI")
Rel(api, reports, "Формирование отчётов")
Rel(importer, db, "Запись данных")
Rel(kpi, db, "Чтение данных")
Rel(kpi, cache, "Кэширование")
Rel(reports, storage, "Сохранение файлов")
Rel(source, importer, "Передача данных")
Rel(reports, email, "Уведомления")
@enduml
